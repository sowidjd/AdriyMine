   "kunci": [
    "obat"
   ]
  },
  {
   "id": "s2",
   "gap": 0.2,
   "style": "storytelling, clear",
   "text": "Peneliti di Universitas Reading, Inggris, menyetel lagu yang gampang nyangkut ke sembilan puluh delapan orang.",
