{
 "judul": "Lagu nyangkut dari bangun tidur, padahal kamu nggak suka",
 "lead": 0.3,
 "lines": [
  {
   "id": "h1",
   "gap": 0.2,
   "style": "groggy, annoyed, comedic",
   "text": "Kamu bangun tidur, dan lagu yang kamu benci udah muter di kepala.",
   "cap": "Bangun tidur, *lagu nyebelin* udah muter",
   "kunci": [
    "bangun",
    "lagu"
   ]
  },
  {
   "id": "h2",
   "gap": 0.2,
   "style": "exasperated, comedic",
   "text": "Seharian nggak mau pergi.",
   "cap": "Seharian *nggak mau pergi*",
   "kunci": [
    "seharian"
   ]
  },
  {
   "id": "h3",
   "gap": 1.3,
   "style": "sly, mysterious",
   "text": "Ada penelitian yang nemu obatnya. Dan obatnya aneh banget.",
   "cap": "Obatnya ada. Dan *aneh banget.*",
   "kunci": [
    "penelitian",
    "obatnya"
   ]
  },
  {
   "id": "m1",
   "gap": 0.2,
   "style": "friendly storytelling",
   "text": "Coba ingat-ingat.",
   "cap": "Coba ingat-ingat...",
   "kunci": [
    "ingat"
   ]
  },
  {
   "id": "m2",
   "gap": 0.2,
   "style": "storytelling, light",
   "text": "Lagu iklan yang kamu dengar sekali di warung.",
   "cap": "Lagu iklan di *warung*",
   "kunci": [
    "iklan",
    "warung"
   ]
  },
  {
   "id": "m3",
   "gap": 0.2,
   "style": "storytelling, annoyed",
   "text": "Tiba-tiba muter terus. Waktu mandi, waktu kerja, waktu mau tidur.",
   "cap": "Mandi, kerja, mau tidur: *muter terus*",
   "kunci": [
    "mandi",
    "tidur"
   ]
  },
  {
   "id": "m4",
   "gap": 0.2,
   "style": "explainer, playful",
   "text": "Yang muter juga bukan satu lagu utuh.",
   "cap": "Bukan *lagu utuh*",
   "kunci": [
    "utuh"
   ]
  },
  {
   "id": "m5",
   "gap": 0.3,
   "style": "playful, rhythmic",
   "text": "Biasanya cuma potongan pendek, diputar ulang terus, kayak kaset rusak.",
   "cap": "Potongan pendek, *kayak kaset rusak*",
   "kunci": [
    "potongan",
    "kaset"
   ]
  },
  {
   "id": "m6",
   "gap": 0.2,
   "style": "frustrated, comedic",
   "text": "Lagi ujian, malah nyanyi dalam hati.",
   "cap": "Lagi ujian, *malah nyanyi*",
   "kunci": [
    "ujian",
    "nyanyi"
   ]
  },
  {
   "id": "m7",
   "gap": 1.3,
   "style": "frustrated",
   "text": "Lagi ngobrol, jadi nggak fokus.",
   "cap": "Lagi ngobrol, *nggak fokus*",
   "kunci": [
    "ngobrol",
    "fokus"
   ]
  },
  {
   "id": "m8",
   "gap": 0.2,
   "style": "warm, reassuring",
   "text": "Tenang, kamu nggak sendirian.",
   "cap": "Kamu *nggak sendirian*",
   "kunci": [
    "sendirian"
   ]
  },
  {
   "id": "m9",
   "gap": 0.2,
   "style": "clear, informative",
   "text": "Penelitian di Goldsmiths, London, menemukan hampir sembilan dari sepuluh orang mengalaminya.",
   "cap": "Hampir *9 dari 10* orang mengalaminya",
   "kunci": [
    "london",
    "sembilan dari sepuluh"
   ]
  },
  {
   "id": "m10",
   "gap": 0.2,
   "style": "clear",
   "text": "Paling tidak seminggu sekali.",
   "cap": "Minimal *seminggu sekali*",
   "kunci": [
    "seminggu sekali"
   ]
  },
  {
   "id": "m11",
   "gap": 1.3,
   "style": "clear explainer, friendly",
   "text": "Ilmuwan menyebutnya earworm. Artinya, cacing telinga.",
   "cap": "Namanya: *earworm* (cacing telinga)",
   "kunci": [
    "cacing telinga"
   ]
  },
  {
   "id": "d1",
   "gap": 0.2,
   "style": "thoughtful",
   "text": "Biasanya kita coba melawan.",
   "cap": "Kita coba *melawan*",
   "kunci": [
    "melawan"
   ]
  },
  {
   "id": "d2",
   "gap": 0.2,
   "style": "thoughtful, determined",
   "text": "Kita paksa diri buat nggak memikirkan lagu itu.",
   "cap": "Paksa diri *nggak mikirin*",
   "kunci": [
    "paksa"
   ]
  },
  {
   "id": "d3",
   "gap": 0.2,
   "style": "thoughtful",
   "text": "Atau kita setel lagu lain, biar ketimpa.",
   "cap": "Setel lagu lain *biar ketimpa*",
   "kunci": [
    "ketimpa"
   ]
  },
  {
   "id": "d4",
   "gap": 1.3,
   "style": "deflated, comedic",
   "text": "Hasilnya? Sering kali, lagunya balik lagi.",
   "cap": "Hasilnya? *Balik lagi.*",
   "kunci": [
    "hasilnya",
    "balik lagi"
   ]
  },
  {
   "id": "p1",
   "gap": 0.2,
   "style": "curious, intrigued",
   "text": "Kenapa lagu tertentu gampang banget nyangkut?",
   "cap": "Kenapa *gampang nyangkut?*",
   "kunci": [
    "nyangkut"
   ]
  },
  {
   "id": "p2",
   "gap": 0.2,
   "style": "storytelling, clear",
   "text": "Tahun dua ribu enam belas, peneliti bertanya ke tiga ribu orang, lagu apa yang paling sering nyangkut.",
   "cap": "2016: *3.000 orang* ditanya",
   "kunci": [
    "tiga ribu"
   ]
  },
  {
   "id": "p3",
   "gap": 0.2,
   "style": "clear explainer",
   "text": "Ternyata, lagu-lagu itu punya ciri yang mirip.",
   "cap": "Lagu nyangkut punya *ciri mirip*",
   "kunci": [
    "ciri",
    "mirip"
   ]
  },
  {
   "id": "p4",
   "gap": 0.2,
   "style": "lively, listing",
   "text": "Temponya lebih cepat.",
   "cap": "1. Tempo *lebih cepat*",
   "kunci": [
    "tempo",
    "cepat"
   ]
  },
  {
   "id": "p5",
   "gap": 0.2,
   "style": "lively, listing",
   "text": "Nadanya naik-turun dengan pola yang gampang ditebak.",
   "cap": "2. Pola nada *gampang ditebak*",
   "kunci": [
    "pola",
    "ditebak"
   ]
  },
  {
   "id": "p6",
   "gap": 0.2,
   "style": "lively, listing",
   "text": "Tapi ada lompatan nada yang nggak biasa.",
   "cap": "3. Ada *lompatan nada*",
   "kunci": [
    "lompatan"
   ]
  },
  {
   "id": "p7",
   "gap": 1.3,
   "style": "lively, listing",
   "text": "Dan biasanya, lagu itu sering diputar di radio.",
   "cap": "4. Sering diputar di *radio*",
   "kunci": [
    "radio"
