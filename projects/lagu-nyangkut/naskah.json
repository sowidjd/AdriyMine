   "gap": 0.4,
   "style": "amused, laughing a little",
   "text": "kami langsung kepikiran lagu iklan.",
   "cap": "...langsung kepikiran *lagu iklan*",
   "kunci": [
    "iklan"
   ]
  },
  {
   "id": "p8",
   "gap": 0.2,
   "style": "curious",
   "text": "Lalu, kenapa susah diusir?",
