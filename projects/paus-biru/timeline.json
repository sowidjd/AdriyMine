{"duration": 174.25, "lines": [{"id": "h1", "t0": 0.3, "t1": 3.1, "cap": "Jantungmu: *± 60×* semenit"}, {"id": "h2", "t0": 3.25, "t1": 6.45, "cap": "Paus biru: *cuma 2×*"}, {"id": "h3", "t0": 6.7, "t1": 8.3, "cap": "Dan dia *baik-baik saja*"}, {"id": "h4", "t0": 8.5, "t1": 10.5, "cap": "Gimana bisa? *Kita bahas.*"}, {"id": "m1", "t0": 11.4, "t1": 13.8, "cap": "Bayangin kamu *menyelam*"}, {"id": "m2", "t0": 14.0, "t1": 16.4, "cap": "Dada mulai *sesak*"}, {"id": "m3", "t0": 16.6, "t1": 19.8, "cap": "Buru-buru *ambil napas*"}, {"id": "m4", "t0": 20.1, "t1": 22.5, "cap": "Tubuh butuh *oksigen terus*"}, {"id": "m5", "t0": 22.7, "t1": 25.1, "cap": "Otak & otot *minta oksigen*"}, {"id": "m6", "t0": 25.3, "t1": 28.9, "cap": "Darah dipompa *jantung*"}, {"id": "m7", "t0": 29.8, "t1": 32.2, "cap": "Sekarang jadi *paus biru*"}, {"id": "m8", "t0": 32.4, "t1": 35.2, "cap": "Hewan *terbesar* yang pernah hidup"}, {"id": "m9", "t0": 35.4, "t1": 38.2, "cap": "Panjang *> 30 meter*"}, {"id": "m10", "t0": 38.4, "t1": 41.2, "cap": "≈ *2,5 bus kota*"}, {"id": "m11", "t0": 41.5, "t1": 44.7, "cap": "Napas pakai *paru-paru*"}, {"id": "m12", "t0": 44.9, "t1": 47.7, "cap": "Makanan di *bawah laut*"}, {"id": "m13", "t0": 47.9, "t1": 51.9, "cap": "Tahan napas, *menyelam dalam*"}, {"id": "m14", "t0": 52.1, "t1": 54.5, "cap": "Oksigennya *dari mana?*"}, {"id": "d1", "t0": 55.4, "t1": 59.4, "cap": "Dikira: memompa *super kencang*"}, {"id": "d2", "t0": 59.6, "t1": 62.0, "cap": "Biar sampai *ujung ekor*"}, {"id": "d3", "t0": 62.2, "t1": 63.4, "cap": "Masuk akal..."}, {"id": "d4", "t0": 63.6, "t1": 64.8, "cap": "Ternyata *kebalikannya*"}, {"id": "a1", "t0": 65.7, "t1": 68.9, "cap": "Waktu kami di *Adriy.Project* baca catatannya..."}, {"id": "a1b", "t0": 69.8, "t1": 71.4, "cap": "...kami sampai *menghitung ulang*"}, {"id": "p1", "t0": 71.8, "t1": 77.4, "cap": "2019: alat perekam dari *Stanford*"}, {"id": "p2", "t0": 77.6, "t1": 80.8, "cap": "Rekaman detak jantung paus biru *pertama*"}, {"id": "p3", "t0": 81.0, "t1": 85.4, "cap": "Saat menyelam: *4–8×* semenit"}, {"id": "p4", "t0": 85.6, "t1": 87.2, "cap": "Paling lambat: *2×!*"}, {"id": "p5", "t0": 87.5, "t1": 90.7, "cap": "Jeda antar detak: *± 30 detik*"}, {"id": "p6", "t0": 91.0, "t1": 93.8, "cap": "Lambat = *oksigen hemat*"}, {"id": "p7", "t0": 94.0, "t1": 96.4, "cap": "Kuat menyelam *lebih lama*"}, {"id": "p8", "t0": 96.6, "t1": 101.4, "cap": "Saat menerjang makanan: naik *± 2,5×*"}, {"id": "p9", "t0": 101.6, "t1": 106.8, "cap": "Pembuluh besar yang *lentur* ikut mendorong"}, {"id": "s1", "t0": 107.7, "t1": 111.3, "cap": "Saat naik untuk *bernapas?*"}, {"id": "s2", "t0": 111.5, "t1": 115.1, "cap": "Ngebut sampai *± 37×*"}, {"id": "s3", "t0": 115.3, "t1": 118.5, "cap": "Oksigen baru *cepat tersebar*"}, {"id": "s4", "t0": 118.8, "t1": 123.2, "cap": "Jawabannya: jago *ngerem* & jago *ngegas*"}, {"id": "s5", "t0": 123.6, "t1": 128.0, "cap": "Jantungnya hampir di *batas maksimal*"}, {"id": "s6", "t0": 128.2, "t1": 133.4, "cap": "Mungkin itu sebab tak ada yang *lebih besar*"}, {"id": "s7", "t0": 134.3, "t1": 137.5, "cap": "Kita juga punya *rem kecil*"}, {"id": "s8", "t0": 137.7, "t1": 142.9, "cap": "Wajah di air dingin = *detak melambat*"}, {"id": "s9", "t0": 143.1, "t1": 145.5, "cap": "...tapi *jauh lebih kecil*"}, {"id": "r1", "t0": 146.4, "t1": 151.2, "cap": "Pelan justru *kunci bertahan*"}, {"id": "c1", "t0": 151.7, "t1": 153.3, "cap": "Sekarang *giliran kamu*"}, {"id": "c2", "t0": 153.5, "t1": 156.7, "cap": "Tahan napas *10 detik*..."}, {"id": "c3", "t0": 156.9, "t1": 161.3, "cap": "Tulis *\"lambat\"* atau *\"kencang\"* di komentar!"}, {"id": "c4", "t0": 161.5, "t1": 164.7, "cap": "Siapa yang paling *mirip paus?*"}, {"id": "c5", "t0": 164.9, "t1": 169.7, "cap": "*Simpan* buat pamer ke teman"}, {"id": "z", "t0": 170.15, "t1": 171.75, "cap": ""}], "perkiraan": true}