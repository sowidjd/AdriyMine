{"duration": 173.9, "lines": [{"id": "h1", "t0": 0.3, "t1": 2.3, "cap": "Berhenti hapus pesan *3 paragraf*"}, {"id": "h2", "t0": 2.5, "t1": 5.7, "cap": "Ada *alasan* kamu selalu ragu"}, {"id": "h3", "t0": 5.9, "t1": 8.3, "cap": "...dan *bukan* karena lebay"}, {"id": "m1", "t0": 9.2, "t1": 10.2, "cap": "Coba ingat-ingat..."}, {"id": "m2", "t0": 10.4, "t1": 13.2, "cap": "Malam-malam, balas pesan *gebetan*"}, {"id": "m3", "t0": 13.4, "t1": 16.6, "cap": "Ketik panjang, *rapi*"}, {"id": "m4", "t0": 16.8, "t1": 20.0, "cap": "\"Kok kepanjangan, ya?\""}, {"id": "m5", "t0": 20.3, "t1": 22.7, "cap": "Dikira *lebay?* Dia *ilfil?*"}, {"id": "m6", "t0": 22.95, "t1": 24.95, "cap": "Hapus. Ketik. *Hapus lagi.*"}, {"id": "m7", "t0": 25.15, "t1": 27.15, "cap": "Yang terkirim: *wkwk*"}, {"id": "m8", "t0": 28.05, "t1": 29.65, "cap": "Atau di *grup kelas*"}, {"id": "m9", "t0": 29.85, "t1": 33.85, "cap": "Takut dikira *nggak nyimak*"}, {"id": "m10", "t0": 34.05, "t1": 36.05, "cap": "Jempol di tombol *kirim*..."}, {"id": "m11", "t0": 36.25, "t1": 39.45, "cap": "...lalu *pura-pura* nggak jadi nanya"}, {"id": "m12", "t0": 39.75, "t1": 43.75, "cap": "Kayak dibaca pakai *kaca pembesar*"}, {"id": "m13", "t0": 44.05, "t1": 47.65, "cap": "*10 menit* buat 1 pesan"}, {"id": "d1", "t0": 48.55, "t1": 51.75, "cap": "Dikira: *kurang percaya diri*"}, {"id": "d2", "t0": 51.95, "t1": 53.95, "cap": "Atau terlalu *baper*"}, {"id": "d3", "t0": 54.15, "t1": 57.35, "cap": "\"Udah, *bodo amat!*\""}, {"id": "d4", "t0": 57.55, "t1": 59.15, "cap": "Besoknya: *kejadian lagi*"}, {"id": "d5", "t0": 59.45, "t1": 61.45, "cap": "Masalahnya *bukan di situ*"}, {"id": "p1", "t0": 62.35, "t1": 65.95, "cap": "Namanya: *spotlight effect*"}, {"id": "p2", "t0": 66.15, "t1": 70.95, "cap": "Efek *lampu sorot*"}, {"id": "p3", "t0": 71.15, "t1": 75.15, "cap": "2000: percobaan di *Universitas Cornell*"}, {"id": "p4", "t0": 75.35, "t1": 79.35, "cap": "Pakai *kaos memalukan*"}, {"id": "p5", "t0": 79.55, "t1": 82.75, "cap": "Masuk ke *ruangan ramai*"}, {"id": "p6", "t0": 82.95, "t1": 86.55, "cap": "\"Berapa yang *lihat kaosmu?*\""}, {"id": "p7", "t0": 86.75, "t1": 88.75, "cap": "Tebakan: *separuh* ruangan"}, {"id": "a1", "t0": 89.65, "t1": 92.05, "cap": "Waktu kami di *Adriy.Project* baca hasilnya..."}, {"id": "a1b", "t0": 92.95, "t1": 94.15, "cap": "...kami *ketawa sendiri*"}, {"id": "p8", "t0": 94.5, "t1": 98.1, "cap": "Aslinya: *± 1 dari 5* orang"}, {"id": "p9", "t0": 98.5, "t1": 100.1, "cap": "Kenapa *meleset jauh?*"}, {"id": "p10", "t0": 100.3, "t1": 103.9, "cap": "Kita merasakan diri *dari dalam*"}, {"id": "p11", "t0": 104.1, "t1": 108.1, "cap": "Dikira orang lain lihat *sejelas itu*"}, {"id": "p12", "t0": 108.3, "t1": 110.7, "cap": "Padahal mereka *sibuk sendiri*"}, {"id": "p13", "t0": 111.0, "t1": 115.0, "cap": "Hal mirip: rasa *gugup*"}, {"id": "p14", "t0": 115.2, "t1": 119.2, "cap": "Gugupmu *nggak sejelas itu*"}, {"id": "s1", "t0": 120.1, "t1": 122.9, "cap": "Terus, *gimana?*"}, {"id": "s2", "t0": 123.15, "t1": 125.95, "cap": "1. Ingat *efek lampu sorot*"}, {"id": "s3", "t0": 126.15, "t1": 133.75, "cap": "Tahu efeknya = *lebih tenang*"}, {"id": "s4", "t0": 134.05, "t1": 136.85, "cap": "2. Baca *1 kali* saja"}, {"id": "s5", "t0": 137.05, "t1": 140.65, "cap": "Ada kata yang *nyakitin?*"}, {"id": "s6", "t0": 140.85, "t1": 142.85, "cap": "Nggak ada? *Kirim!*"}, {"id": "s7", "t0": 143.15, "t1": 145.15, "cap": "3. Lihat *besoknya*"}, {"id": "s8", "t0": 145.35, "t1": 148.55, "cap": "Ada yang bahas? *Biasanya nggak.*"}, {"id": "r1", "t0": 149.45, "t1": 153.85, "cap": "Lampu sorot itu *cuma di kepala kita*"}, {"id": "c1", "t0": 154.35, "t1": 155.95, "cap": "Sekarang *giliran kamu*"}, {"id": "c2", "t0": 156.15, "t1": 159.35, "cap": "Tim *hapus* atau tim *kirim?*"}, {"id": "c3", "t0": 159.55, "t1": 164.35, "cap": "Tulis *\"hapus\"* atau *\"kirim\"* di komentar!"}, {"id": "c4", "t0": 164.55, "t1": 169.35, "cap": "Kirim ke teman yang suka bales *wkwk*"}, {"id": "z", "t0": 169.8, "t1": 171.4, "cap": ""}], "perkiraan": true}