{
  "name": "catatanbyadriy-intro",
  "private": true,
  "scripts": {
    "render": "remotion render src/index.ts Intro out/intro.webm --codec=vp9 --crf=30 --scale=0.6666666666666666 --concurrency=2",
    "studio": "remotion studio src/index.ts",
    "build": "npm run render && npm run render-dark && cp out/intro.webm out/intro_dark.webm ../www/media/",
    "render-dark": "remotion render src/index.ts IntroDark out/intro_dark.webm --codec=vp9 --crf=30 --scale=0.6666666666666666 --concurrency=2"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "remotion": "4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/react": "18.3.12"
  }
}