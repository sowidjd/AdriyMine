    "berbeda"
   ]
  },
  {
   "id": "d4",
   "gap": 0.2,
   "style": "clear explainer",
   "text": "Rasa lapar diatur oleh hormon dan otak.",
   "cap": "Lapar: diatur *hormon & otak*",
