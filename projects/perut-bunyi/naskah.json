  {
   "id": "p8",
   "gap": 0.2,
   "style": "clear explainer",
   "text": "Gelombangnya datang lagi, kira-kira setiap satu setengah sampai dua jam.",
   "cap": "Datang lagi tiap *1,5–2 jam*",
   "kunci": [
    "setiap",
    "dua jam"
