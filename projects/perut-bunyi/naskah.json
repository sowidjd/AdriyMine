   "kunci": [
    "alasan"
   ]
  },
  {
   "id": "m1",
   "gap": 0.2,
   "style": "friendly storytelling",
   "text": "Coba ingat-ingat.",
   "cap": "Coba ingat-ingat...",
   "kunci": [
    "ingat"
   ]
  },
  {
   "id": "m2",
   "gap": 0.2,
   "style": "storytelling, light",
   "text": "Lagi rapat, lagi ibadah, atau lagi nonton bioskop yang sepi.",
   "cap": "Rapat, ibadah, *bioskop sepi*",
   "kunci": [
    "rapat",
    "bioskop"
   ]
  },
  {
   "id": "m3",
   "gap": 0.2,
   "style": "storytelling, dramatic",
   "text": "Perutmu bunyi, panjang, dan nyaring.",
   "cap": "Panjang & *nyaring*",
   "kunci": [
    "panjang",
    "nyaring"
   ]
  },
  {
   "id": "m4",
   "gap": 0.2,
   "style": "embarrassed",
   "text": "Orang di sebelah langsung melirik.",
   "cap": "Orang sebelah *melirik*",
   "kunci": [
    "melirik"
   ]
  },
  {
   "id": "m5",
   "gap": 0.2,
   "style": "comedic, sheepish",
   "text": "Kamu pura-pura batuk, biar suaranya ketutupan.",
   "cap": "Pura-pura *batuk*",
   "kunci": [
    "batuk"
   ]
  },
  {
   "id": "m6",
   "gap": 0.3,
   "style": "comedic, desperate",
   "text": "Atau kamu tekan perut, sambil berharap bunyinya berhenti.",
   "cap": "Tekan perut, *berharap berhenti*",
   "kunci": [
    "tekan",
    "berhenti"
   ]
  },
  {
   "id": "m6b",
   "gap": 0.2,
   "style": "comedic, anxious",
   "text": "Makin kamu tegang, rasanya bunyinya makin lama.",
   "cap": "Makin tegang, *makin lama*",
   "kunci": [
    "tegang"
   ]
  },
  {
   "id": "m7",
   "gap": 0.2,
   "style": "puzzled",
   "text": "Yang bikin heran, kadang kamu baru saja makan.",
   "cap": "Padahal *baru makan*",
   "kunci": [
    "heran",
    "makan"
   ]
  },
  {
   "id": "m8",
   "gap": 0.2,
   "style": "puzzled",
   "text": "Kadang juga, kamu sama sekali nggak merasa lapar.",
   "cap": "Dan *nggak lapar*",
   "kunci": [
    "lapar"
   ]
  },
  {
   "id": "m9",
   "gap": 0.9,
   "style": "curious, slower",
   "text": "Terus, suara itu sebenarnya dari mana?",
   "cap": "Suaranya *dari mana?*",
   "kunci": [
    "suara",
    "dari mana"
   ]
  },
  {
   "id": "d1",
   "gap": 0.2,
   "style": "thoughtful",
   "text": "Kebanyakan orang mengira, perut bunyi artinya perut kosong minta diisi.",
   "cap": "Dikira: *minta diisi*",
   "kunci": [
    "mengira",
    "kosong"
   ]
  },
  {
   "id": "d2",
   "gap": 0.2,
   "style": "light, comedic",
   "text": "Jadi kita buru-buru jajan.",
   "cap": "Buru-buru *jajan*",
   "kunci": [
    "jajan"
   ]
  },
  {
   "id": "d3",
   "gap": 0.2,
   "style": "clear explainer",
   "text": "Padahal, rasa lapar dan suara perut itu dua hal yang berbeda.",
