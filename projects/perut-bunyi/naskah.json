{
 "judul": "Perut bunyi pas kelas hening? Itu bukan tanda lapar",
 "lead": 0.3,
 "lines": [
  {
   "id": "h1",
   "gap": 0.2,
   "style": "tense, whispering, slow",
   "text": "Kelas lagi hening. Semua lagi ujian.",
   "cap": "Kelas *hening*. Lagi ujian...",
   "kunci": [
    "hening",
    "ujian"
   ]
  },
  {
   "id": "h2",
   "gap": 0.3,
   "style": "comedic panic, sudden",
   "text": "Tiba-tiba, perutmu bunyi keras banget.",
   "cap": "Tiba-tiba: *perut bunyi!*",
   "kunci": [
    "perutmu",
    "bunyi"
   ]
  },
  {
   "id": "h3",
   "gap": 0.2,
   "style": "firm, teasing",
   "text": "Tenang. Itu belum tentu tanda kamu lapar.",
   "cap": "*Belum tentu* lapar",
   "kunci": [
    "lapar"
   ]
  },
  {
   "id": "h4",
   "gap": 0.9,
   "style": "curious, mysterious",
   "text": "Ada alasan lain, dan jarang yang tahu.",
