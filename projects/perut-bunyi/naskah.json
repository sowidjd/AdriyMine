   "kunci": [
    "usus",
    "mendorong"
   ]
  },
  {
   "id": "p4",
   "gap": 0.2,
   "style": "clear explainer",
   "text": "Isinya bukan cuma makanan. Ada cairan, dan ada udara.",
   "cap": "Isinya: *cairan & udara*",
   "kunci": [
    "cairan",
    "udara"
   ]
  },
  {
   "id": "p5",
   "gap": 0.9,
   "style": "clear explainer, playful",
   "text": "Saat udara dan cairan terdorong, muncullah suara gemuruh.",
   "cap": "Terdorong = *gemuruh*",
   "kunci": [
    "gemuruh"
   ]
  },
  {
   "id": "p5b",
   "gap": 0.9,
   "style": "clear explainer, calm",
   "text": "Sebenarnya, usus bergemuruh hampir sepanjang waktu. Biasanya saja, suaranya teredam makanan.",
   "cap": "Usus bergemuruh *hampir terus*",
   "kunci": [
    "sepanjang waktu",
    "teredam"
   ]
  },
  {
   "id": "a1",
   "gap": 0.9,
   "style": "warm, proud, slower, clear emphasis on the channel name",
   "text": "Waktu kami di Adriy.Project mempelajari soal ini...",
   "cap": "Waktu kami di *Adriy.Project* mempelajari ini...",
   "kunci": [
    "titik"
   ]
