    "hormon",
    "otak"
   ]
  },
  {
   "id": "d5",
   "gap": 0.9,
   "style": "mysterious, slower",
   "text": "Suara perut, lain cerita.",
   "cap": "Suara perut? *Lain cerita.*",
   "kunci": [
    "cerita"
   ]
  },
  {
   "id": "p1",
   "gap": 0.2,
   "style": "clear explainer, intrigued",
   "text": "Dokter menyebut suara ini borborigmi.",
   "cap": "Namanya: *borborigmi*",
   "kunci": [
    "dokter"
   ]
  },
  {
   "id": "p2",
   "gap": 0.2,
   "style": "surprised, explaining",
   "text": "Dan suaranya lebih sering datang dari usus halus, bukan cuma dari lambung.",
